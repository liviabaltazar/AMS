programa {
  funcao inicio() {
    real C,L, preco_m_da_tela, resultado

    escreva("Digite C: ")
    leia(C)
    escreva("Digite L: ")
    leia(L)
    escreva("Digite o preço do metro da tela: ")
    leia(preco_m_da_tela)
    resultado=2*(C+L)*preco_m_da_tela
    
    escreva("O custo para cercareste terreno é: ", resultado)


  }
}
